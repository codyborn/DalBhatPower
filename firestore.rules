rules_version = '2';

// Dal Bhat Index — Firestore security rules.
//
// Trust model
//  * Anyone can read visible content without signing in.
//  * Signed-in (Google) users can create reports, feed posts, confirmations, likes and flags.
//  * Counters, reputation, elevation and moderation status are written ONLY by Cloud Functions
//    (admin SDK bypasses these rules), so clients can't inflate them.
//  * Moderators carry the custom claim {mod: true} (see scripts/set-moderator.js).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isMod() { return signedIn() && request.auth.token.mod == true; }
    function me() { return request.auth.uid; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function notBanned() {
      return !(exists(userPath(me())) && get(userPath(me())).data.get('banned', false) == true);
    }
    function inNepal(lat, lng) {
      return lat is number && lng is number
        && lat > 26.2 && lat < 30.6 && lng > 79.9 && lng < 88.4;
    }
    function shortString(s, min, max) {
      return s is string && s.size() >= min && s.size() <= max;
    }
    function validTown(d) {
      return shortString(d.town, 1, 60) && shortString(d.townKey, 1, 60)
        && d.townKey.matches('^[a-z0-9-]+$');
    }

    // ---------- users ----------
    // Profile doc is created by the client on first sign-in with reputation 0.
    // Reputation / banned are only ever changed by Cloud Functions.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'reputation', 'createdAt'])
        && shortString(request.resource.data.displayName, 1, 60)
        && (request.resource.data.photoURL == null || shortString(request.resource.data.photoURL, 0, 500))
        && request.resource.data.reputation == 0
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && me() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL'])
        && shortString(request.resource.data.displayName, 1, 60);
      allow delete: if false;
    }

    // ---------- price reports (menu photos) ----------
    match /reports/{reportId} {
      allow read: if resource.data.status == 'visible'
        || isMod()
        || (signedIn() && resource.data.uid == me());

      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly([
             'uid', 'town', 'townKey', 'lat', 'lng', 'geoSource',
             'priceNpr', 'meal', 'venueType', 'venueName', 'refills',
             'photoPath', 'observedAt', 'timeSource',
             'status', 'flagScore', 'confirmCount', 'createdAt'])
        && request.resource.data.uid == me()
        && validTown(request.resource.data)
        && inNepal(request.resource.data.lat, request.resource.data.lng)
        && request.resource.data.geoSource in ['exif', 'device', 'map']
        && request.resource.data.priceNpr is int
        && request.resource.data.priceNpr >= 30 && request.resource.data.priceNpr <= 5000
        && request.resource.data.meal in ['veg', 'chicken', 'mutton', 'fish', 'other']
        && request.resource.data.venueType in ['local', 'teahouse', 'restaurant']
        && shortString(request.resource.data.venueName, 0, 80)
        && request.resource.data.refills is bool
        && request.resource.data.photoPath is string
        && request.resource.data.photoPath.matches('^uploads/' + me() + '/menus/[A-Za-z0-9_.-]+$')
        && request.resource.data.observedAt is timestamp
        && request.resource.data.observedAt <= request.time + duration.value(1, 'd')
        && request.resource.data.observedAt > timestamp.date(2015, 1, 1)
        && request.resource.data.timeSource in ['exif', 'upload']
        && request.resource.data.status == 'visible'
        && request.resource.data.flagScore == 0
        && request.resource.data.confirmCount == 0
        && request.resource.data.createdAt == request.time;

      allow update: if false;   // edits go through functions only
      allow delete: if signedIn() && resource.data.uid == me();

      // "I paid this too" confirmations — one per user, not on your own report.
      match /confirms/{uid} {
        allow read: if true;
        allow create: if signedIn() && notBanned() && me() == uid
          && get(/databases/$(database)/documents/reports/$(reportId)).data.uid != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && me() == uid;
      }
    }

    // ---------- dal bhat feed ----------
    match /posts/{postId} {
      allow read: if resource.data.status == 'visible'
        || isMod()
        || (signedIn() && resource.data.uid == me());

      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly([
             'uid', 'photoPath', 'caption', 'town', 'townKey', 'priceNpr',
             'status', 'likeCount', 'flagScore', 'createdAt'])
        && request.resource.data.uid == me()
        && request.resource.data.photoPath is string
        && request.resource.data.photoPath.matches('^uploads/' + me() + '/meals/[A-Za-z0-9_.-]+$')
        && shortString(request.resource.data.caption, 0, 280)
        && validTown(request.resource.data)
        && (request.resource.data.priceNpr == null
            || (request.resource.data.priceNpr is int
                && request.resource.data.priceNpr >= 30 && request.resource.data.priceNpr <= 5000))
        && request.resource.data.status == 'visible'
        && request.resource.data.likeCount == 0
        && request.resource.data.flagScore == 0
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == me();

      match /likes/{uid} {
        allow read: if true;
        allow create: if signedIn() && notBanned() && me() == uid
          && get(/databases/$(database)/documents/posts/$(postId)).data.uid != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && me() == uid;
      }
    }

    // ---------- abuse flags ----------
    // Doc id is deterministic so each user can flag a given item only once:
    //   {targetType}__{targetId}__{uid}
    match /flags/{flagId} {
      allow get: if isMod() || (signedIn() && resource.data.uid == me());
      allow list: if isMod();
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['uid', 'targetType', 'targetId', 'reason', 'note', 'createdAt'])
        && request.resource.data.uid == me()
        && request.resource.data.targetType in ['reports', 'posts']
        && flagId == request.resource.data.targetType + '__' + request.resource.data.targetId + '__' + me()
        && exists(/databases/$(database)/documents/$(request.resource.data.targetType)/$(request.resource.data.targetId))
        && get(/databases/$(database)/documents/$(request.resource.data.targetType)/$(request.resource.data.targetId)).data.uid != me()
        && request.resource.data.reason in ['wrong-price', 'not-dal-bhat', 'spam', 'offensive', 'private-info', 'other']
        && shortString(request.resource.data.note, 0, 200)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Moderation log is written by functions, readable by moderators.
    match /modlog/{entryId} {
      allow read: if isMod();
      allow write: if false;
    }
  }
}
